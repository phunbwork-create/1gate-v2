// 1Gate System — Prisma Schema (Prisma 7)
// Note: datasource URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum RoleName {
  SUPER_ADMIN
  ADMIN
  DIRECTOR
  ACCOUNTANT
  DEPT_HEAD
  PURCHASER
  WAREHOUSE
  EMPLOYEE
}

enum ProcurementPlanStatus {
  DRAFT
  SUBMITTED
  DEPT_HEAD_APPROVED
  DIRECTOR_APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  COMPLETED
}

enum NotificationType {
  SUBMISSION
  APPROVAL
  REJECTION
  REMINDER
  SYSTEM
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments      Department[]
  users            User[]
  procurementPlans ProcurementPlan[]
  materialRequests MaterialRequest[]
  purchaseRequests PurchaseRequest[]

  @@map("companies")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users            User[]
  procurementPlans ProcurementPlan[]
  materialRequests MaterialRequest[]
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, code])
  @@map("departments")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  displayName String
  description String?

  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  action   String
  resource String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action, resource])
  @@map("permissions")
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String
  isActive       Boolean   @default(true)
  avatar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?

  roleId       String
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])

  notificationChannel NotificationChannel?
  notifications       Notification[]
  auditLogs           AuditLog[]
  sessions            Session[]
  accounts            Account[]

  // Procurement relations
  procurementPlansRequested     ProcurementPlan[]    @relation("ProcurementPlanRequester")
  procurementPlansDeptHead      ProcurementPlan[]    @relation("ProcurementPlanDeptHead")
  procurementPlansDirector      ProcurementPlan[]    @relation("ProcurementPlanDirector")
  materialRequestsRequested     MaterialRequest[]    @relation("MaterialRequestRequester")
  materialRequestsApproved      MaterialRequest[]    @relation("MaterialRequestApprover")
  purchaseRequestsRequested     PurchaseRequest[]    @relation("PurchaseRequestRequester")
  purchaseRequestsReceived      PurchaseRequest[]    @relation("PurchaseRequestReceiver")

  @@map("users")
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Notification Models ─────────────────────────────────────────────────────

model NotificationChannel {
  id              String  @id @default(cuid())
  emailEnabled    Boolean @default(true)
  telegramEnabled Boolean @default(false)
  telegramChatId  String?
  webEnabled      Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_channels")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─── Phase 2: Procurement ─────────────────────────────────────────────────────

model ProcurementPlan {
  id             String                @id @default(cuid())
  code           String                @unique
  title          String
  description    String?
  totalAmount    Decimal?              @db.Decimal(15, 2)
  status         ProcurementPlanStatus @default(DRAFT)
  rejectedReason String?

  requestedById String
  requestedBy   User   @relation("ProcurementPlanRequester", fields: [requestedById], references: [id])

  approvedByDeptHeadId String?
  approvedByDeptHead   User?     @relation("ProcurementPlanDeptHead", fields: [approvedByDeptHeadId], references: [id])
  approvedByDeptHeadAt DateTime?

  approvedByDirectorId String?
  approvedByDirector   User?     @relation("ProcurementPlanDirector", fields: [approvedByDirectorId], references: [id])
  approvedByDirectorAt DateTime?

  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  items            ProcurementPlanItem[]
  materialRequests MaterialRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([requestedById])
  @@map("procurement_plans")
}

model ProcurementPlanItem {
  id             String   @id @default(cuid())
  itemName       String
  quantity       Decimal  @db.Decimal(10, 3)
  unit           String
  estimatedPrice Decimal? @db.Decimal(15, 2)
  note           String?

  planId String
  plan   ProcurementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("procurement_plan_items")
}

model MaterialRequest {
  id             String                @id @default(cuid())
  code           String                @unique
  title          String
  description    String?
  status         MaterialRequestStatus @default(DRAFT)
  rejectedReason String?

  planId String?
  plan   ProcurementPlan? @relation(fields: [planId], references: [id])

  requestedById String
  requestedBy   User   @relation("MaterialRequestRequester", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("MaterialRequestApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  items            MaterialRequestItem[]
  purchaseRequests PurchaseRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("material_requests")
}

model MaterialRequestItem {
  id       String  @id @default(cuid())
  itemName String
  quantity Decimal @db.Decimal(10, 3)
  unit     String
  note     String?

  requestId String
  request   MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("material_request_items")
}

model PurchaseRequest {
  id             String                @id @default(cuid())
  code           String                @unique
  stockCheckNote String?
  status         PurchaseRequestStatus @default(DRAFT)

  materialRequestId String?
  materialRequest   MaterialRequest? @relation(fields: [materialRequestId], references: [id])

  requestedById String
  requestedBy   User   @relation("PurchaseRequestRequester", fields: [requestedById], references: [id])

  receivedById String?
  receivedBy   User?     @relation("PurchaseRequestReceiver", fields: [receivedById], references: [id])
  receivedAt   DateTime?

  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  items PurchaseRequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id             String   @id @default(cuid())
  itemName       String
  quantity       Decimal  @db.Decimal(10, 3)
  unit           String
  estimatedPrice Decimal? @db.Decimal(15, 2)
  note           String?

  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
}
